rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isFounderAdmin() {
      return isAuthenticated() && request.auth.token.email == 'tabipsubayi@gmail.com';
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isApproved() {
      return isFounderAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'approved'
      );
    }
    
    function isAdmin() {
      return isFounderAdmin() || (isApproved() && getUserData().role == 'admin');
    }
    
    function isCaptain() {
      return isFounderAdmin() || (isApproved() && (getUserData().role == 'captain' || getUserData().role == 'admin'));
    }

    // User collection: read open, invited/authenticated users can create/upgrade their own profile; admin manages all
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isFounderAdmin());
      allow delete: if isAdmin();
    }

    // Invites collection: cross-device invite resolution
    match /invites/{inviteId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // All club reads open for Spectator/Visitor view; writes strictly protected
    match /players/{playerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isCaptain() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isLegend'])
      ) || (
        isApproved() &&
        getUserData().claimedPlayerId == playerId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['baseOVR', 'currentOVR', 'isLegend'])
      );
    }

    match /app_state/{docId} {
      allow read: if true;
      allow create, update: if isApproved();
      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isApproved();
      allow delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    match /locker_posts/{postId} {
      allow read: if true;
      allow create, update: if isApproved();
      allow delete: if isAdmin() || (isApproved() && resource.data.authorPlayerId == getUserData().claimedPlayerId);
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if isApproved();
      allow delete: if isAdmin();
    }

    match /debts/{debtId} {
      allow read: if true;
      allow create, update: if isApproved();
      allow delete: if isAdmin();
    }
  }
}
